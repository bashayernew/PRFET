# PRFET — environment template
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Generated 2026-08-23 by scanning every process.env.* reference in the codebase.

# ─── Core (required to boot) ───────────────────────────────────────────────
# Local dev uses the Postgres from docker-compose.yml (port 5433).
DATABASE_URL="postgresql://herot:herot_dev_password@localhost:5433/herot?schema=public"
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV=development

# Only used by docker-compose on the server.
POSTGRES_PASSWORD=""
DOMAIN=""

# ─── Auth (REQUIRED — see note) ────────────────────────────────────────────
# lib/auth.ts silently falls back to the literals "dev-access-secret-change-me" /
# "dev-refresh-secret-change-me" when these are unset. Those strings are public in
# the repo, so an unset secret in production means anyone can forge a login token
# for any account. Always set these. Never change them in prod (it logs everyone out).
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ─── Admin dashboard second lock ───────────────────────────────────────────
# app/api/admin/gate/route.ts ships a hardcoded break-glass email + bcrypt hash and a
# starter password ("admin123") that is accepted until an admin password is set in
# the dashboard. Set DASH_MASTER_DISABLED=1 before public launch.
DASH_MASTER_EMAIL=""
DASH_MASTER_HASH=""
DASH_MASTER_DISABLED=0

# ─── Email: OTP + support ──────────────────────────────────────────────────
# The app supports both SMTP and Resend. Configure at least one.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RESEND_API_KEY=""
RESEND_FROM=""
SUPPORT_EMAIL=""

# ─── Web push (VAPID) ──────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─── Realtime video / voice ────────────────────────────────────────────────
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""
TURN_SECRET=""
NEXT_PUBLIC_TURN_URL=""

# ─── AI (Gemini) ───────────────────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL=""
GEMINI_IMAGE_MODEL=""
GEMINI_VIDEO_MODEL=""
GEMINI_TTS_MODEL=""
GEMINI_TTS_MALE=""
GEMINI_TTS_FEMALE=""

# ─── Payments: FastSpring (web checkout) ───────────────────────────────────
NEXT_PUBLIC_FASTSPRING_STOREFRONT=""
FASTSPRING_HMAC_SECRET=""
FASTSPRING_SKU_VIP=""
FASTSPRING_SKU_GOLDEN=""
FASTSPRING_SKU_ADDON_VOICE=""
FASTSPRING_SKU_ADDON_STORAGE=""
FASTSPRING_SKU_ADDON_MEDIA=""
NEXT_PUBLIC_FS_VIP=""
NEXT_PUBLIC_FS_GOLDEN=""
NEXT_PUBLIC_FS_ADDON_VOICE=""
NEXT_PUBLIC_FS_ADDON_STORAGE=""
NEXT_PUBLIC_FS_ADDON_MEDIA=""

# ─── Moderation ────────────────────────────────────────────────────────────
# 1 = new ads go live without review. Leave 0 in production.
AD_AUTO_APPROVE=0
