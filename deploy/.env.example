# ---- Herot server env (copy to deploy/.env and fill in) ----
DOMAIN=your-domain.com

# App
DATABASE_URL=postgresql://herot:CHANGE_ME_DB@db:5432/herot?schema=public
POSTGRES_PASSWORD=CHANGE_ME_DB
JWT_ACCESS_SECRET=CHANGE_ME_long_random
JWT_REFRESH_SECRET=CHANGE_ME_long_random
NODE_ENV=production

# Calls (TURN) — the app reads these to build ICE servers
TURN_SECRET=CHANGE_ME_turn_secret
NEXT_PUBLIC_TURN_URL=turn:your-domain.com:3478
NEXT_PUBLIC_TURN_SECRET=CHANGE_ME_turn_secret

# Meetings (LiveKit)
LIVEKIT_API_KEY=herotkey
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.your-domain.com

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME
