# Auto-HTTPS for your domain. Set the real domain via the $DOMAIN env (deploy/.env).
{$DOMAIN} {
	# Compress all text/JSON/JS/CSS responses — big transfer-size win, invisible to users.
	encode zstd gzip
	reverse_proxy app:3000
}

# LiveKit signaling (websocket) on a subdomain — point livekit.<domain> DNS at the server too.
livekit.{$DOMAIN} {
	reverse_proxy host.docker.internal:7880
}
