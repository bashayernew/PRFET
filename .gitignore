/node_modules
/.next
/out
/build
.DS_Store
*.pem
.env*
.vercel
next-env.d.ts
/ios
/android
/public/uploads/

# IDE + build cache + junk
/.idea
*.tsbuildinfo
.write-test
*.tmp.*

# personal / non-app files that must never be published
*.docx
Bashayer_Abouamer_Resume.docx
Manayer_Abouamer_Resume.docx

# env template SHOULD be tracked (the .env* rule above would otherwise hide it)
!.env.example

# scratch copy of local dev secrets — never commit
local-env-copy-to-dotenv.txt

# clone leftovers — safe to delete
_to_delete/

# Firebase — never commit these
google-services.json
android/app/google-services.json
*firebase-adminsdk*.json

# Signing keys and mail credentials — these WERE committed once and had to be removed
# with `git rm --cached`. Without these rules a single `git add -A` puts them straight
# back in the public repo.
*.jks
*.keystore
ses-smtp-user.*.csv

# Google Cloud service-account keys. Chrome downloads these with the project id as the
# filename, and on 2026-09-26 one landed in app/ — inside the repo — purely because that
# was the last folder used in the save dialog. Keep the real file OUTSIDE the project
# (D:\secrets\ on the owner's PC); these patterns are the backstop.
gen-lang-client-*.json
*-service-account*.json
*serviceaccount*.json
